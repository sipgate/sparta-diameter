<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.sipgate</groupId>
    <artifactId>sparta-diameter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>sparta-diameter</name>
    <description>Java library for the Diameter protocol by sipgate</description>
    <url>https://github.com/sipgate/sparta-diameter</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>takuto88</id>
            <name>Lennart Rosam</name>
            <email>rosam@sipgate.de</email>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/sipgate/sparta-diameter</url>
        <connection>scm:git:git://github.com/sipgate/sparta-diameter.git</connection>
        <developerConnection>scm:git:ssh://github.com:sipgate/sparta-diameter.git</developerConnection>
    </scm>
    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>0.10.2</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.2.10.Final</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <!-- can't upgrade to 6.x because they dropped support for Java 1.8, see https://github.com/junit-team/junit-framework/wiki/Upgrading-to-JUnit-6.0#new-baselines -->
            <version>5.14.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <!-- can't upgrade to 5.x because they dropped support for Java 1.8, see https://github.com/mockito/mockito?tab=readme-ov-file#current-version-is-5x -->
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
            </plugin>
        </plugins>
    </build>
</project>
